---
// Splash hero — lives in an Astro component (not MDX) so the markup is
// emitted verbatim: MDX would wrap loose text in <p>, nesting <p> inside
// the poster and breaking the layout.
---

<section class="phosphor-hero">
	<div class="frame">
		<div class="corners"></div>

		<div class="meta-top">
			<span><svg class="glyph" viewBox="0 0 128 128" fill="none" aria-hidden="true"><path d="M34 36 66 64 34 92" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" /><rect x="74" y="79" width="34" height="14" rx="3" fill="currentColor" /></svg> ratelcode</span>
			<span>—</span>
			<span>independent robot evaluation</span>
			<span style="margin-left: auto">SO-101 · real hardware</span>
		</div>

		<div class="anchors">
			<span class="anchor cap" data-label="Cap height"></span>
			<span class="anchor x" data-label="X-height"></span>
			<span class="anchor base" data-label="Baseline"></span>
			<span class="anchor desc" data-label="Descender"></span>
			{/* decorative poster copy — the page's real h1 is the (visually
			    hidden) Starlight title; two h1s would break a11y */}
			<p class="poster-h1" aria-hidden="true">
				Physical-ai.<br />
				<span class="accent">evaluate.</span><span class="cursor"></span>
			</p>
		</div>

		<div class="meta-bot">
			<span>by ratelcode</span>
			<span>— evaluation · VLA · reproducibility · silent failure · open raw logs</span>
			<span class="prompt">$ ls evals/</span>
		</div>

	</div>
</section>
