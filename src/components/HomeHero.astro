---
// Splash hero — lives in an Astro component (not MDX) so the markup is
// emitted verbatim: MDX would wrap loose text in <p>, nesting <p> inside
// the poster and breaking the layout.
// Layout implements the "Home Final" Claude Design comp (framed poster,
// subtitle, CTAs; brand mark lives in the Starlight header, not here).

// The header nav is desktop-only (≥50rem) and the splash template has no
// sidebar/hamburger, so on mobile these CTAs are the ONLY navigation.
// Desktop shows just the primary (theme.css hides the secondaries there,
// where the header nav already covers them) — keep all three in markup.
const isKo = Astro.url.pathname.startsWith('/ko/') || Astro.url.pathname === '/ko';
const base = isKo ? '/ko' : '';
const t = isKo
	? {
			tagline: '독립 로봇 평가',
			sub: '공개 VLA 정책을 실로봇에서 직접 돌려 본 재현성 리포트 — 모든 숫자를 직접 검증할 수 있도록 원시 로그·시드·설정을 함께 공개합니다.',
			posts: '전체 리포트',
			method: '측정 프로토콜',
			about: '소개',
		}
	: {
			tagline: 'independent robot evaluation',
			sub: 'Reproducibility reports from running open VLA policies on a real robot — with the raw logs, seeds, and configs to check every number yourself.',
			posts: 'All reports',
			method: 'Methodology',
			about: 'About',
		};
---

<section class="phosphor-hero">
	<div class="frame">
		<div class="corners"></div>

		<div class="meta-top">
			<span class="glyph">■</span>
			<span>{t.tagline}</span>
			<span style="margin-left: auto">SO-101 · real hardware</span>
		</div>

		<div class="poster">
			{/* decorative poster copy — the page's real h1 is the (visually
			    hidden) Starlight title; two h1s would break a11y */}
			<p class="poster-h1" aria-hidden="true">
				Physical-ai.<br />
				<span class="accent">evaluate.</span><span class="cursor"></span>
			</p>
			<p class="hero-sub">{t.sub}</p>
		</div>

		<div class="ctas">
			<a class="btn primary" href={`${base}/blog/`}>{t.posts} →</a>
			<a class="btn" href={`${base}/methodology/protocol/`}>{t.method}</a>
			<a class="btn" href={`${base}/about/`}>{t.about}</a>
		</div>

		<div class="meta-bot">
			<span>evaluation · VLA · reproducibility · silent failure · open raw logs</span>
			<span class="prompt">$ ls evals/</span>
		</div>

	</div>
</section>
