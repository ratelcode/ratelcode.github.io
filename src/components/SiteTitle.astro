---
// Custom site title — brand mark with phosphor glyph + version (from package.json).
import pkg from '../../package.json';
---

<a href="/" class="brand-mark">
	<svg class="glyph" viewBox="0 0 128 128" fill="none" aria-hidden="true">
		<path d="M34 36 66 64 34 92" stroke="currentColor" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />
		<rect x="74" y="79" width="34" height="14" rx="3" fill="currentColor" />
	</svg>
	<span class="name">ratelcode</span>
	<span class="ver">v{pkg.version}</span>
</a>
