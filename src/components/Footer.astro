---
import Default from '@astrojs/starlight/components/Footer.astro';

const route = Astro.locals.starlightRoute?.id ?? '';
const displayRoute = route === '' ? 'home' : route;

const lang = Astro.locals.starlightRoute?.lang ?? 'en';
const isKo = lang.startsWith('ko');
const displayLocale = isKo ? 'ko_KR.UTF-8' : 'en_US.UTF-8';

// Independence disclaimer, localized to the page's locale.
const disclaimer = isKo
	? '이 사이트의 모든 글은 개인 견해이며, 소속 조직과 무관합니다. 평가에는 공개 모델·공개 벤치마크·본인 소유 장비만 사용합니다.'
	: 'Everything here is my personal opinion and unrelated to any organization I belong to. Evaluations use only public models, public benchmarks, and hardware I own.';
---

<Default><slot /></Default>

<div class="site-disclaimer">{disclaimer}</div>

{/* "Home Final" comp segments (RIG / CONTACT) alongside the original dynamic
    ROUTE / LOCALE; the static BUILD versions gave visitors the least, so the
    comp's segments replaced it. */}
<div class="statusbar" aria-hidden="true">
	<span class="seg"><span class="pulse-dot"></span><span class="key">●</span> ratelcode@workshop:~$</span>
	<span class="sep">│</span>
	<span class="seg"><span class="key">ROUTE</span> /{displayRoute}</span>
	<span class="sep">│</span>
	<span class="seg optional"><span class="key">LOCALE</span> {displayLocale}</span>
	<span class="sep">│</span>
	<span class="seg optional"><span class="key">RIG</span> SO-101 · RTX 5070 Ti</span>
	<span class="sep">│</span>
	<span class="seg optional"><span class="key">CONTACT</span> github.com/ratelcode</span>
</div>
