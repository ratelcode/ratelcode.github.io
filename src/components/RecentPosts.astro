---
interface Props {
	limit?: number;
}

const { limit = 4 } = Astro.props;

// starlight-blog middleware provides posts pre-sorted by date (desc) with
// draft filtering and canonical hrefs — no need to re-derive from getCollection.
// `.filter(!draft)` keeps dev-mode parity with the production build.
const posts = Astro.locals.starlightBlog.posts
	.filter((post) => !post.draft)
	.slice(0, limit);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<div class="posts">
	{
		posts.map((post) => (
			<a class="post-row" href={post.href}>
				<div class="pr-date">{fmt(post.createdAt)}</div>
				<div>
					<h3 class="pr-title">{post.entry.data.title}</h3>
					{post.entry.data.excerpt && <p class="pr-desc">{post.entry.data.excerpt}</p>}
				</div>
				{post.tags.length > 0 && (
					<div class="pr-tags">
						{post.tags.map((tag) => (
							<span>{tag.label}</span>
						))}
					</div>
				)}
			</a>
		))
	}
</div>
